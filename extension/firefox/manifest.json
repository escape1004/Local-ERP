{
  "manifest_version": 3,
  "name": "Local ERP",
  "version": "1.1.26",
  "description": "LCERP 레코드 목록과 사용자 스크립트",
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lcerp-browser@local-erp",
      "strict_min_version": "121.0"
    }
  },
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://*/*",
    "https://*/*"
  ],
  "sidebar_action": {
    "default_title": "Local ERP",
    "default_panel": "sidepanel.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Local ERP 레코드",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png",
      "48": "icons/idle-48.png",
      "128": "icons/idle-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://accounts.google.com/*",
        "https://accounts.youtube.com/*",
        "https://accounts.google.co.kr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
